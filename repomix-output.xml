<file path="templates/admin_complaints.html">
{% extends 'base.html' %}{% block title %}Manage complaints · ABU Resolve{% endblock %}{% block content %}
<section class="page-heading"><span class="eyebrow">ADMINISTRATION</span><h1>Manage complaints</h1><p>Review reports, assign priority, update progress, and record an action note.</p></section><div class="filter-pills"><a class="{{ 'active' if not selected_status else '' }}" href="{{ url_for('admin_complaints') }}">All</a>{% for s in statuses %}<a class="{{ 'active' if selected_status == s else '' }}" href="{{ url_for('admin_complaints', status=s) }}">{{ s }}</a>{% endfor %}</div><section class="content-card">{% if complaints %}<div class="admin-case-list">{% for c in complaints %}<article class="admin-case"><div class="admin-case-head"><div><span class="eyebrow">{{ c.reference }} · {{ c.category }}</span><h3>{{ c.title }}</h3><p>{{ c.full_name }} · {{ c.created_at }}{% if c.location %} · {{ c.location }}{% endif %}</p></div><span class="status {{ c.status|lower|replace(' ', '-') }}">{{ c.status }}</span></div><p class="case-description">{{ c.description }}</p><form method="post" class="admin-update-form"><input type="hidden" name="reference" value="{{ c.reference }}"><label>Status<select name="status">{% for s in statuses %}<option {{ 'selected' if c.status == s else '' }}>{{ s }}</option>{% endfor %}</select></label><label>Priority<select name="priority">{% for p in priorities %}<option {{ 'selected' if c.priority == p else '' }}>{{ p }}</option>{% endfor %}</select></label><label>Assigned office<input name="assigned_office" value="{{ c.assigned_office or '' }}" placeholder="Responsible office"></label><label class="note-field">Action / response note<textarea name="admin_note" rows="2" placeholder="Add an update the student can see">{{ c.admin_note or '' }}</textarea></label><div class="form-actions"><a class="text-link" href="{{ url_for('complaint_detail', complaint_id=c.reference) }}">View details →</a><button class="btn primary" type="submit">Save update</button></div></form></article>{% endfor %}</div>{% else %}<div class="empty-state"><span>▤</span><h3>No complaints in this view</h3><p>Try another status filter.</p></div>{% endif %}</section>
{% endblock %}
</file>

<file path="templates/admin_dashboard.html">
{% extends 'base.html' %}{% block title %}Admin overview · ABU Resolve{% endblock %}{% block content %}
<section class="page-heading heading-row"><div><span class="eyebrow">ADMINISTRATION</span><h1>Complaint overview</h1><p>Review incoming concerns and keep cases moving.</p></div><a class="btn primary" href="{{ url_for('admin_complaints') }}">Manage complaints <span>→</span></a></section><section class="stats-grid"><div class="stat-card"><span class="stat-label">Total reports</span><strong>{{ total }}</strong><span class="stat-foot">All submitted complaints</span><span class="stat-icon">▤</span></div><div class="stat-card"><span class="stat-label">Awaiting review</span><strong>{{ stats['Submitted'] }}</strong><span class="stat-foot">New submissions</span><span class="stat-icon sand">◷</span></div><div class="stat-card"><span class="stat-label">In progress</span><strong>{{ stats['In Progress'] }}</strong><span class="stat-foot">Action underway</span><span class="stat-icon blue">↗</span></div><div class="stat-card"><span class="stat-label">Resolved</span><strong>{{ stats['Resolved'] }}</strong><span class="stat-foot">Marked complete</span><span class="stat-icon green">✓</span></div></section><section class="content-card"><div class="section-heading"><div><h2>Latest complaints</h2><p>Recently submitted student concerns.</p></div><a class="text-link" href="{{ url_for('admin_complaints') }}">View all →</a></div>{% if complaints %}<div class="table-wrap"><table><thead><tr><th>Complaint</th><th>Student</th><th>Category</th><th>Priority</th><th>Status</th><th></th></tr></thead><tbody>{% for c in complaints %}<tr><td><a class="table-title" href="{{ url_for('complaint_detail', complaint_id=c.reference) }}">{{ c.title }}<small>{{ c.reference }}</small></a></td><td>{{ c.full_name }}</td><td>{{ c.category }}</td><td><span class="priority {{ c.priority|lower }}">{{ c.priority }}</span></td><td><span class="status {{ c.status|lower|replace(' ', '-') }}">{{ c.status }}</span></td><td><a class="row-arrow" href="{{ url_for('complaint_detail', complaint_id=c.reference) }}">→</a></td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="empty-state"><span>✓</span><h3>You're all caught up</h3><p>New student complaints will appear here.</p></div>{% endif %}</section><div class="demo-note"><b>AI module: next stage</b><span>This prototype currently uses simple rules for initial routing and priority. We’ll replace or augment these with a trained model after collecting and preparing suitable complaint data.</span></div>
{% endblock %}
</file>

<file path="templates/auth.html">
{% extends 'base.html' %}{% block title %}{{ 'Create account' if mode == 'register' else 'Sign in' }} · ABU Resolve{% endblock %}{% block content %}
<div class="auth-layout"><div class="auth-aside"><span class="eyebrow">ABU RESOLVE</span><h1>{{ 'Let’s get you started.' if mode == 'register' else 'Welcome back.' }}</h1><p>{{ 'Create an account to submit campus concerns and follow their progress.' if mode == 'register' else 'Sign in to view your complaints and stay up to date.' }}</p><div class="aside-quote">“A concern reported clearly is a concern that can be acted on.”</div></div><section class="form-panel"><div class="form-heading"><span class="eyebrow">{{ 'JOIN THE COMMUNITY' if mode == 'register' else 'GOOD TO SEE YOU AGAIN' }}</span><h2>{{ 'Create your account' if mode == 'register' else 'Sign in to ABU Resolve' }}</h2><p>{{ 'It only takes a minute.' if mode == 'register' else 'Enter your details to continue.' }}</p></div><form method="post" class="form-stack">{% if mode == 'register' %}<label>Full name<input name="full_name" placeholder="e.g. Maryam Aliyu" autocomplete="name" required></label>{% endif %}<label>Email address<input type="email" name="email" placeholder="you@example.com" autocomplete="email" required></label><label>Password<input type="password" name="password" placeholder="At least 8 characters" minlength="8" autocomplete="{{ 'new-password' if mode == 'register' else 'current-password' }}" required></label><button class="btn primary full" type="submit">{{ 'Create account' if mode == 'register' else 'Sign in' }} <span>→</span></button></form><p class="switch-auth">{% if mode == 'register' %}Already have an account? <a href="{{ url_for('login') }}">Sign in</a>{% else %}New to ABU Resolve? <a href="{{ url_for('register') }}">Create an account</a>{% endif %}</p>{% if mode == 'login' %}<div class="admin-hint"><b>Development admin demo</b><span>Email: admin@aburesolve.local</span><span>Password: Admin123!</span><small>Change this password and secret key before any real deployment.</small></div>{% endif %}</section></div>
{% endblock %}
</file>

<file path="templates/base.html">
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}ABU Resolve{% endblock %}</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>
<header class="topbar"><a class="brand" href="{{ url_for('index') }}"><span class="brand-mark">ar</span><span>ABU <b>Resolve</b><small>Student support, made clearer.</small></span></a>
  {% if current_user %}<nav class="desktop-nav">{% if current_user.role == 'admin' %}<a href="{{ url_for('admin_dashboard') }}">Overview</a><a href="{{ url_for('admin_complaints') }}">Manage complaints</a>{% else %}<a href="{{ url_for('dashboard') }}">Home</a><a href="{{ url_for('my_complaints') }}">My complaints</a><a class="nav-cta" href="{{ url_for('new_complaint') }}">+ New complaint</a>{% endif %}<a href="{{ url_for('logout') }}">Sign out</a></nav>{% else %}<nav class="desktop-nav"><a href="{{ url_for('login') }}">Sign in</a><a class="nav-cta" href="{{ url_for('register') }}">Create account</a></nav>{% endif %}
</header>
<main class="page-wrap">
  {% with messages = get_flashed_messages(with_categories=true) %}{% if messages %}<div class="flash-stack">{% for category, message in messages %}<div class="flash {{ category }}">{{ message }}</div>{% endfor %}</div>{% endif %}{% endwith %}
  {% block content %}{% endblock %}
</main>
<footer class="footer"><span>ABU Resolve</span><span>Helping concerns reach the right people.</span></footer>
{% if current_user %}<div class="mobile-nav"><a href="{{ url_for('admin_dashboard') if current_user.role == 'admin' else url_for('dashboard') }}">⌂<small>Home</small></a><a href="{{ url_for('admin_complaints') if current_user.role == 'admin' else url_for('my_complaints') }}">▤<small>{{ 'Manage' if current_user.role == 'admin' else 'My cases' }}</small></a>{% if current_user.role != 'admin' %}<a href="{{ url_for('new_complaint') }}">＋<small>Submit</small></a>{% endif %}<a href="{{ url_for('logout') }}">↗<small>Sign out</small></a></div>{% endif %}
</body></html>
</file>

<file path="templates/complaint_detail.html">
{% extends 'base.html' %}{% block title %}{{ item.title }} · ABU Resolve{% endblock %}{% block content %}
<section class="page-heading"><a class="back-link" href="{{ url_for('admin_complaints') if current_user.role == 'admin' else url_for('my_complaints') }}">← Back to complaints</a><span class="eyebrow">COMPLAINT {{ item.reference }}</span><h1>{{ item.title }}</h1><p>Submitted {{ item.created_at }} · {{ item.category }}</p></section><div class="detail-layout"><section class="content-card"><div class="detail-top"><span class="status {{ item.status|lower|replace(' ', '-') }}">{{ item.status }}</span><span class="priority {{ item.priority|lower }}">{{ item.priority }} priority</span></div><h2>What was reported</h2><p class="detail-description">{{ item.description }}</p><div class="detail-meta"><div><small>Category</small><b>{{ item.category }}</b></div><div><small>Location</small><b>{{ item.location or 'Not provided' }}</b></div><div><small>Assigned office</small><b>{{ item.assigned_office or 'Awaiting assignment' }}</b></div><div><small>Last updated</small><b>{{ item.updated_at }}</b></div></div>{% if item.admin_note %}<div class="response-note"><b>Latest update from the reviewing team</b><p>{{ item.admin_note }}</p></div>{% endif %}</section><aside class="content-card progress-card"><h2>Progress</h2><p class="muted">Your complaint’s current stage.</p><div class="timeline">{% for step in ['Submitted','Under Review','In Progress','Resolved'] %}<div class="timeline-step {{ 'complete' if statuses.index(item.status) >= statuses.index(step) and item.status != 'Rejected' else '' }} {{ 'current' if item.status == step else '' }}"><span class="timeline-dot">{% if statuses.index(item.status) >= statuses.index(step) and item.status != 'Rejected' %}✓{% else %}{{ loop.index }}{% endif %}</span><div><b>{{ step }}</b><small>{% if item.status == step %}Current status{% elif statuses.index(item.status) > statuses.index(step) and item.status != 'Rejected' %}Completed{% else %}Waiting for update{% endif %}</small></div></div>{% endfor %}{% if item.status == 'Rejected' %}<div class="response-note"><b>Status: Rejected</b><p>{{ item.admin_note or 'Please contact the reviewing office if you need clarification.' }}</p></div>{% endif %}</div><div class="reference-box"><small>Keep this reference number</small><b>{{ item.reference }}</b></div></aside></div>
{% endblock %}
</file>

<file path="templates/complaints.html">
{% extends 'base.html' %}{% block title %}My complaints · ABU Resolve{% endblock %}{% block content %}
<section class="page-heading heading-row"><div><span class="eyebrow">YOUR REPORTS</span><h1>My complaints</h1><p>All your reports, in one place.</p></div><a class="btn primary" href="{{ url_for('new_complaint') }}">＋ New complaint</a></section><div class="filter-pills"><a class="{{ 'active' if not selected_status else '' }}" href="{{ url_for('my_complaints') }}">All</a>{% for s in statuses %}<a class="{{ 'active' if selected_status == s else '' }}" href="{{ url_for('my_complaints', status=s) }}">{{ s }}</a>{% endfor %}</div><section class="content-card">{% if complaints %}<div class="table-wrap"><table><thead><tr><th>Complaint</th><th>Category</th><th>Date submitted</th><th>Priority</th><th>Status</th><th></th></tr></thead><tbody>{% for c in complaints %}<tr><td><a class="table-title" href="{{ url_for('complaint_detail', complaint_id=c.reference) }}">{{ c.title }}<small>{{ c.reference }}</small></a></td><td>{{ c.category }}</td><td>{{ c.created_at }}</td><td><span class="priority {{ c.priority|lower }}">{{ c.priority }}</span></td><td><span class="status {{ c.status|lower|replace(' ', '-') }}">{{ c.status }}</span></td><td><a class="row-arrow" href="{{ url_for('complaint_detail', complaint_id=c.reference) }}">→</a></td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="empty-state"><span>▤</span><h3>No complaints found</h3><p>{% if selected_status %}There are no complaints with this status.{% else %}Your submitted complaints will appear here.{% endif %}</p><a class="btn primary" href="{{ url_for('new_complaint') }}">Submit a complaint</a></div>{% endif %}</section>
{% endblock %}
</file>

<file path="templates/dashboard.html">
{% extends 'base.html' %}{% block title %}Your dashboard · ABU Resolve{% endblock %}{% block content %}
<section class="page-heading heading-row"><div><span class="eyebrow">YOUR SPACE</span><h1>Good day, {{ current_user.full_name.split()[0] }} <span class="wave">✳</span></h1><p>Let’s make sure your concerns get to the right place.</p></div><a class="btn primary" href="{{ url_for('new_complaint') }}">＋ Submit a complaint</a></section>
<section class="stats-grid"><div class="stat-card"><span class="stat-label">All complaints</span><strong>{{ total }}</strong><span class="stat-foot">Your submitted reports</span><span class="stat-icon">▤</span></div><div class="stat-card"><span class="stat-label">Under review</span><strong>{{ stats['Under Review'] }}</strong><span class="stat-foot">Being assessed</span><span class="stat-icon sand">◷</span></div><div class="stat-card"><span class="stat-label">In progress</span><strong>{{ stats['In Progress'] }}</strong><span class="stat-foot">Action underway</span><span class="stat-icon blue">↗</span></div><div class="stat-card"><span class="stat-label">Resolved</span><strong>{{ stats['Resolved'] }}</strong><span class="stat-foot">Marked complete</span><span class="stat-icon green">✓</span></div></section>
<section class="content-card"><div class="section-heading"><div><h2>Recent complaints</h2><p>Keep an eye on the reports you’ve submitted.</p></div><a class="text-link" href="{{ url_for('my_complaints') }}">View all <span>→</span></a></div>{% if complaints %}<div class="complaint-list">{% for c in complaints %}<a class="complaint-row" href="{{ url_for('complaint_detail', complaint_id=c.reference) }}"><span class="case-icon">{{ '◉' if c.category in ['Water','Electricity'] else '⌂' if c.category == 'Accommodation' else '▤' }}</span><span class="case-main"><b>{{ c.title }}</b><small>{{ c.reference }} · {{ c.category }} · {{ c.created_at }}</small></span><span class="status {{ c.status|lower|replace(' ', '-') }}">{{ c.status }}</span><span class="row-arrow">→</span></a>{% endfor %}</div>{% else %}<div class="empty-state"><span>▤</span><h3>No complaints yet</h3><p>When you submit a complaint, you’ll be able to track it here.</p><a class="btn primary" href="{{ url_for('new_complaint') }}">Submit your first complaint</a></div>{% endif %}</section>
<section class="help-banner"><div class="help-mark">✦</div><div><h3>Not sure where your concern belongs?</h3><p>Choose the category that feels closest. Your report can be reviewed and routed to the appropriate office.</p></div><a class="btn secondary" href="{{ url_for('new_complaint') }}">Report an issue</a></section>
{% endblock %}
</file>

<file path="templates/message.html">
{% extends 'base.html' %}{% block title %}{{ heading }} · ABU Resolve{% endblock %}{% block content %}<section class="empty-state standalone-empty"><span>↗</span><h1>{{ heading }}</h1><p>{{ message }}</p><a class="btn primary" href="{{ url_for('index') }}">Return home</a></section>{% endblock %}
</file>

<file path="templates/new_complaint.html">
{% extends 'base.html' %}{% block title %}Submit a complaint · ABU Resolve{% endblock %}{% block content %}
<section class="page-heading"><a class="back-link" href="{{ url_for('dashboard') }}">← Back to dashboard</a><span class="eyebrow">WE’RE HERE TO HELP</span><h1>Tell us what’s happening.</h1><p>Share the details of the issue so it can be reviewed and sent to the right office.</p></section>
<div class="submit-layout"><form method="post" class="content-card form-stack complaint-form"><div class="form-section-title"><span>01</span><div><h2>Complaint details</h2><p>Start with the main information.</p></div></div><label>Complaint title<input name="title" placeholder="e.g. No water supply in hostel block" maxlength="120" required></label><label>What is this about?<select name="category" required><option value="">Choose a category</option>{% for cat in categories %}<option>{{ cat }}</option>{% endfor %}</select></label><label>Location <span class="optional">Optional</span><input name="location" placeholder="e.g. Suleiman Hall, Block B"></label><label>Describe the issue<textarea name="description" rows="6" minlength="15" placeholder="What happened? When did you first notice it? Who or what is affected?" required></textarea><small class="field-help">Please avoid including passwords or other private information.</small></label><div class="form-actions"><a class="btn secondary" href="{{ url_for('dashboard') }}">Cancel</a><button class="btn primary" type="submit">Submit complaint <span>→</span></button></div></form><aside class="side-help"><div class="side-help-icon">✦</div><h3>A few helpful tips</h3><ul><li>Use a short, clear title.</li><li>Include the location if it helps identify the issue.</li><li>Explain what happened and how it affects students.</li><li>For immediate danger, contact the appropriate emergency or campus security service directly.</li></ul><div class="privacy-note"><b>Your report matters</b><p>Your complaint will be linked to your account so you can follow updates.</p></div></aside></div>
